# Database connection string
# For SQLite (development):
DATABASE_URL="file:./prisma/dev.db"

# For PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/clipconnect?schema=public"

# JWT Secret - IMPORTANT: Use a strong random string in production
# Generate with: openssl rand -base64 32
JWT_SECRET="your-secure-secret-here"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Configuration (optional in development - emails will be logged to console)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# EMAIL_FROM="ClipConnect <noreply@clipconnect.com>"
